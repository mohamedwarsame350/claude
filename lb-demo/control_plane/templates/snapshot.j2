# xDS snapshot for instance: {{ instance_id }}  plan: {{ plan_id }}
# Delivered here as static YAML; in production pushed over ADS gRPC stream.

static_resources:
  clusters:
    - name: {{ cluster.name }}
      connect_timeout: 0.25s
      type: {{ cluster.type }}
      lb_policy: {{ cluster.lb_policy }}
      load_assignment:
        cluster_name: {{ cluster.name }}
        endpoints:
          - lb_endpoints:
{% for u in cluster.upstreams %}
              - endpoint:
                  address:
                    socket_address:
                      address: {{ u.address }}
                      port_value: {{ u.port }}
{% endfor %}

  listeners:
    - name: {{ listener.name }}
      address:
        socket_address:
          address: 0.0.0.0
          port_value: {{ listener.port }}
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                codec_type: AUTO
                stat_prefix: ingress_http
                route_config:
                  name: local_route
                  virtual_hosts:
                    - name: local_service
                      domains: ["*"]
                      routes:
                        - match:
                            prefix: "/"
                          route:
                            cluster: {{ cluster.name }}
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
