# Envoy config rendered by provisioning worker
# instance: {{ instance_id }}  plan: {{ plan_id }}

static_resources:
  clusters:
    - name: {{ cluster_name }}
      connect_timeout: 0.25s
      type: STRICT_DNS
      lb_policy: {{ lb_algorithm | upper }}
      load_assignment:
        cluster_name: {{ cluster_name }}
        endpoints:
          - lb_endpoints:
{% for u in upstreams %}
              - endpoint:
                  address:
                    socket_address:
                      address: {{ u.address }}
                      port_value: {{ u.port }}
{% endfor %}

  listeners:
    - name: listener_{{ instance_id | replace('-', '_') }}
      address:
        socket_address:
          address: 0.0.0.0
          port_value: {{ listener_port }}
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                codec_type: AUTO
                stat_prefix: ingress_http
                route_config:
                  name: local_route
                  virtual_hosts:
                    - name: local_service
                      domains: ["*"]
                      routes:
                        - match:
                            prefix: "/"
                          route:
                            cluster: {{ cluster_name }}
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
